{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Zapret Manager",
  "version": "0.1.0",
  "identifier": "com.ashleyancient.zapret-manager",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Zapret Manager",
        "width": 420,
        "height": 620,
        "minWidth": 420,
        "minHeight": 620,
        "maxWidth": 420,
        "maxHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "center": true,
        "shadow": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "id": "main-tray",
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false,
      "tooltip": "Zapret Manager"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": ["ru-RU", "en-US"]
      }
    },
    "shortDescription": "GUI для zapret",
    "longDescription": "Десктопный менеджер для утилиты zapret — обход DPI-блокировок на Windows."
  }
}
